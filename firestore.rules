rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function hasAnyRole(roles) {
      return isAuthenticated() && request.auth.token.role in roles;
    }

    function belongsToCollege(collegeId) {
      return isAuthenticated() && request.auth.token.collegeId == collegeId;
    }

    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }

    function isCollegeMember(collegeId) {
      return isSuperAdmin() || belongsToCollege(collegeId);
    }

    function isPrincipal(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['PRINCIPAL', 'VICE_PRINCIPAL', 'SUPER_ADMIN']);
    }

    function isHOD(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['HOD', 'SUPER_ADMIN']);
    }

    function isCollegeOffice(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['COLLEGE_OFFICE', 'SUPER_ADMIN']);
    }

    function isPanelMember(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['PANEL_MEMBER', 'SUPER_ADMIN']);
    }

    function isAccounts(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['ACCOUNTS', 'SUPER_ADMIN']);
    }

    function isExamCell(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['EXAM_CELL', 'SUPER_ADMIN']);
    }

    function isFinance(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['FINANCE', 'SUPER_ADMIN']);
    }

    function isPurchaseDept(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['PURCHASE_DEPT', 'SUPER_ADMIN']);
    }

    // MANAGEMENT is global (no collegeId claim) — unlike the college-scoped roles
    // above, this deliberately does not take a collegeId param.
    function isManagement() {
      return hasRole('MANAGEMENT');
    }

    // WEBMASTER is COLLEGE-scoped, not global — one internal account per
    // college (created by the Principal), provisioning that college's own
    // official institutional emails.
    function isWebmaster(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['WEBMASTER', 'SUPER_ADMIN']);
    }

    function isStaff(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole([
        'PRINCIPAL', 'VICE_PRINCIPAL', 'HOD', 'COLLEGE_OFFICE', 'PANEL_MEMBER', 'ACCOUNTS', 'FINANCE', 'PURCHASE_DEPT', 'WEBMASTER', 'SUPER_ADMIN'
      ]);
    }

    function isHODorAbove(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['HOD', 'PRINCIPAL', 'VICE_PRINCIPAL', 'SUPER_ADMIN']);
    }

    function isPrincipalOrOffice(collegeId) {
      return isCollegeMember(collegeId) && hasAnyRole(['PRINCIPAL', 'VICE_PRINCIPAL', 'COLLEGE_OFFICE', 'SUPER_ADMIN']);
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasCollegeId(collegeId) {
      return request.resource.data.collegeId == collegeId;
    }

    // Faculty members can read their own records (by facultyId matching userUid field)
    // NOTE: This is enforced in API routes; Firestore rules use role-based access
    function isFacultyOwner(facultyId) {
      // In practice ownership is checked in server-side API routes
      return isAuthenticated();
    }

    // ─── System Users (role mapping for non-custom-claim users) ───────────────
    match /systemUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // server-only via Admin SDK
    }

    // Legacy super-admin registry, superseded by systemUsers — no code path
    // writes here anymore, kept read-locked to its own owner for any leftover docs.
    match /superAdmins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // server-only via Admin SDK
    }

    // Root-level platform config singletons (e.g. platformConfig/facultyNorms),
    // distinct from any college-scoped data — SUPER_ADMIN-managed, staff-readable
    // per doc (see /api/admin/settings/faculty-norms).
    match /platformConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Leave module - leave type rules (CL/SL/SCL/EL/OD) are shared across all
    // colleges, SUPER_ADMIN-managed (see /api/leave/seed).
    match /leaveTypes/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Root-level platform audit log (distinct from colleges/{id}/auditLogs below),
    // written by admin-settings routes that have no college context.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ─── Colleges ─────────────────────────────────────────────────────────────

    match /colleges/{collegeId} {
      allow read: if isStaff(collegeId);
      allow create, update, delete: if isSuperAdmin();

      // ─── [ CORE ] ───────────────────────────────────────────────────────────

      match /users/{uid} {
        allow read: if isStaff(collegeId);
        allow create: if isSuperAdmin() && hasCollegeId(collegeId);
        allow update: if isSuperAdmin() || isOwner(uid);
        allow delete: if isSuperAdmin();
      }

      match /departments/{deptId} {
        allow read: if isStaff(collegeId);
        allow create, update: if isPrincipal(collegeId);
        allow delete: if isSuperAdmin();
      }

      // NOTE: faculty norms actually live at the root-level `platformConfig/facultyNorms`
      // singleton (see /api/admin/settings/faculty-norms), not a per-college subcollection —
      // there is no `colleges/{id}/facultyNorms` doc written by any code path.
      //
      // Per-college settings singletons (general info, nav visibility, ...) - all
      // writes happen server-side via the Admin SDK (see /api/college/settings/general,
      // /api/admin/settings/nav-visibility); this rule is defense-in-depth only.
      match /settings/{docId} {
        allow read: if isStaff(collegeId);
        allow write: if isPrincipal(collegeId);
      }

      // ─── [ LEAVE MODULE ] ────────────────────────────────────────────────────
      // Writes happen server-side via the Admin SDK (see /api/leave/*); these
      // rules are defense-in-depth, matching the pattern used elsewhere in this file.

      match /employeeLeaveProfiles/{uid} {
        allow read: if isStaff(collegeId);
        allow create, update: if isHODorAbove(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /leaveBalances/{docId} {
        allow read: if isStaff(collegeId);
        allow write: if false;
      }

      match /leaveRequests/{requestId} {
        allow read: if isStaff(collegeId);
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId);
        allow delete: if isSuperAdmin();
      }

      // ─── [ ACADEMIC STRUCTURE ] ─────────────────────────────────────────────

      match /academicSessions/{sessionId} {
        allow read: if isStaff(collegeId);
        allow create, update, delete: if isPrincipal(collegeId);
      }

      match /academicYears/{yearId} {
        allow read: if isStaff(collegeId);
        allow create, delete: if isPrincipal(collegeId);
      }

      match /courseCatalog/{docId} {
        allow read: if isStaff(collegeId);
        allow create, update, delete: if isPrincipal(collegeId);
      }

      match /courses/{courseId} {
        allow read: if isStaff(collegeId);
        allow create, update, delete: if isPrincipal(collegeId);
      }

      match /courseAcademicYears/{docId} {
        allow read: if isStaff(collegeId);
        allow create, update: if isPrincipal(collegeId);
      }

      match /courseYearTimings/{docId} {
        allow read: if isStaff(collegeId);
        allow create, update, delete: if isPrincipal(collegeId);
      }

      match /sections/{sectionId} {
        allow read: if isStaff(collegeId);
        allow create, update, delete: if isHODorAbove(collegeId);
      }

      match /timetableIncharges/{docId} {
        allow read: if isStaff(collegeId);
        allow create, update, delete: if isHODorAbove(collegeId);
      }

      match /students/{studentId} {
        allow read: if isStaff(collegeId);
        allow create, update: if isHODorAbove(collegeId) || isPanelMember(collegeId);
      }

      // ─── [ FACULTY MODULE ] ─────────────────────────────────────────────────

      match /facultyMembers/{facultyId} {
        allow read: if isStaff(collegeId);
        allow create: if isHODorAbove(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /facultyDocuments/{docId} {
        allow read: if isStaff(collegeId);
        // Faculty can upload their own docs (checked in API by facultyId→userUid match)
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId);
        allow delete: if isHODorAbove(collegeId);
      }

      // ─── [ RECRUITMENT MODULE ] ─────────────────────────────────────────────

      match /vacancyRequests/{requestId} {
        allow read: if isStaff(collegeId);
        allow create: if isHODorAbove(collegeId) && hasCollegeId(collegeId);
        allow update: if isPrincipal(collegeId) || isHOD(collegeId);
        allow delete: if isSuperAdmin();
      }

      // ─── [ BUDGET MODULE ] ────────────────────────────────────────────────
      // HOD creates -> Principal verifies (L1 freeze) -> Finance approves.
      // All writes happen server-side via the Admin SDK in
      // /api/college/budget-requests routes; these rules are defense-in-depth.

      match /budgetRequests/{requestId} {
        allow read: if isStaff(collegeId);
        allow create: if (isHOD(collegeId) || isPrincipal(collegeId)) && hasCollegeId(collegeId);
        allow update: if isHOD(collegeId) || isPrincipal(collegeId) || isFinance(collegeId) || isManagement();
        allow delete: if isSuperAdmin();
      }

      // Budget cycles (submission windows HODs raise budgetRequests against) are
      // defined by Principal/Finance, not HOD.
      match /budgetCycles/{cycleId} {
        allow read: if isStaff(collegeId);
        allow create, update: if isPrincipal(collegeId) || isFinance(collegeId);
        allow delete: if isSuperAdmin();
      }

      // ─── [ INDENT MODULE ] ────────────────────────────────────────────────
      // HOD raises -> Purchase Dept sources quotations -> Finance disburses.
      // All writes happen server-side via the Admin SDK in
      // /api/college/indent-requests routes; these rules are defense-in-depth.

      match /indentRequests/{requestId} {
        allow read: if isStaff(collegeId);
        allow create: if isHOD(collegeId) && hasCollegeId(collegeId);
        allow update: if isHOD(collegeId) || isPurchaseDept(collegeId) || isFinance(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /candidates/{candidateId} {
        allow read: if isStaff(collegeId);
        allow create: if isHOD(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId);
        allow delete: if isHOD(collegeId) || isSuperAdmin();
      }

      // Join entity: candidate <-> vacancyRequest. Carries all per-hiring-cycle
      // state (stage/documents/salary/committee recommendation) so Candidate
      // itself stays a reusable, decoupled person record.
      match /candidateApplications/{applicationId} {
        allow read: if isStaff(collegeId);
        allow create: if isHOD(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId) || isCollegeOffice(collegeId) || isPanelMember(collegeId);
        allow delete: if isHOD(collegeId) || isSuperAdmin();
      }

      match /hiringBatches/{batchId} {
        allow read: if isStaff(collegeId);
        allow create: if isHOD(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId) || isCollegeOffice(collegeId) || isPanelMember(collegeId);
        allow delete: if isSuperAdmin();

        // Feedback as subcollections under the batch
        match /panelFeedback/{feedbackId} {
          allow read: if isStaff(collegeId);
          allow create: if isPanelMember(collegeId) && hasCollegeId(collegeId);
          allow update: if isPanelMember(collegeId) && resource.data.panelUid == request.auth.uid;
          allow delete: if isSuperAdmin();
        }

        // Student feedback: public write (no auth) for QR-based submissions
        match /studentFeedback/{feedbackId} {
          allow read: if isStaff(collegeId);
          allow create: if true;         // public QR-based submission
          allow update, delete: if isSuperAdmin();
        }

      }

      match /hiringSalaryAgreements/{agreementId} {
        allow read: if isHODorAbove(collegeId) || isAccounts(collegeId);
        allow create: if isHODorAbove(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /offerLetters/{letterId} {
        allow read: if isStaff(collegeId);
        allow create, update: if isPrincipalOrOffice(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /appointmentLetters/{letterId} {
        allow read: if isStaff(collegeId);
        allow create, update: if isHODorAbove(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /hiringTermsTemplates/{templateId} {
        allow read: if isStaff(collegeId);
        allow create, update: if isPrincipal(collegeId);
        allow delete: if isSuperAdmin();
      }

      // Office → Webmaster faculty-account handoff. Written exclusively via
      // Admin SDK API routes (see /api/college/faculty-account-requests) —
      // this rule is a read-guard for the dashboard pages, not enforcement.
      match /facultyAccountRequests/{requestId} {
        allow read: if isStaff(collegeId);
        allow write: if false;
      }

      // ─── [ WEBMASTER MODULE ] ───────────────────────────────────────────────
      // College Office requests an official institutional email once a hire is
      // finalized; that college's own WEBMASTER fulfills it. All writes happen
      // server-side via the Admin SDK in /api/college/email-requests routes, so
      // client rules here only gate direct reads.
      match /emailRequests/{requestId} {
        allow read: if isPrincipalOrOffice(collegeId) || isWebmaster(collegeId);
        allow write: if false;
      }

      // ─── [ LEAVE MODULE ] ───────────────────────────────────────────────────

      match /leaveApplications/{appId} {
        allow read: if isStaff(collegeId);
        // Faculty (PANEL_MEMBER role) can apply for leave
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        // HOD approves; Principal approves earned/maternity leave
        allow update: if isHODorAbove(collegeId) ||
          (isPanelMember(collegeId) && resource.data.facultyId == request.auth.uid
            && resource.data.status == 'PENDING');
        allow delete: if isSuperAdmin();
      }

      match /leaveBalances/{balanceId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId) || isAccounts(collegeId);
      }

      // Newer leave engine (src/lib/leave/*) — leaveRequests/leaveApprovalSteps/
      // leaveBalancesV2 supersede leaveApplications/leaveBalances above for staff
      // who apply for their own leave regardless of role (not just PANEL_MEMBER).
      match /employeeLeaveProfiles/{profileId} {
        allow read: if isStaff(collegeId);
        allow create: if (isHODorAbove(collegeId) || isCollegeOffice(collegeId) ||
          (isStaff(collegeId) && request.resource.data.uid == request.auth.uid)) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId) || isCollegeOffice(collegeId) ||
          (isStaff(collegeId) && resource.data.uid == request.auth.uid);
        allow delete: if isSuperAdmin();
      }

      match /leaveRequests/{requestId} {
        allow read: if isStaff(collegeId);
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId) ||
          (isStaff(collegeId) && resource.data.employeeId == request.auth.uid);
        allow delete: if isSuperAdmin();
      }

      match /leaveApprovalSteps/{stepId} {
        allow read: if isStaff(collegeId);
        allow create: if isHODorAbove(collegeId) && hasCollegeId(collegeId);
        allow update, delete: if isSuperAdmin();
      }

      match /leaveBalancesV2/{balanceId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId) || isAccounts(collegeId);
      }

      match /permissionRequests/{reqId} {
        allow read: if isStaff(collegeId);
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isHOD(collegeId) ||
          (isPanelMember(collegeId) && resource.data.facultyId == request.auth.uid
            && resource.data.status == 'PENDING');
        allow delete: if isSuperAdmin();
      }

      match /onDutyRequests/{reqId} {
        allow read: if isStaff(collegeId);
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId) ||
          (isPanelMember(collegeId) && resource.data.facultyId == request.auth.uid
            && resource.data.status == 'PENDING');
        allow delete: if isSuperAdmin();
      }

      // ─── [ ATTENDANCE MODULE ] ──────────────────────────────────────────────

      match /attendanceRecords/{recordId} {
        allow read: if isStaff(collegeId);
        allow create: if isHODorAbove(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /attendanceSummaries/{summaryId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId) || isAccounts(collegeId);
      }

      match /attendanceCheckInPermissions/{permissionId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId);
      }

      match /holidays/{holidayId} {
        allow read: if isStaff(collegeId);
        allow write: if isPrincipalOrOffice(collegeId);
      }

      match /summerHolidays/{summerHolidayId} {
        allow read: if isStaff(collegeId);
        allow write: if isCollegeOffice(collegeId);
      }

      match /workingDays/{workingDayId} {
        allow read: if isStaff(collegeId);
        allow write: if isPrincipalOrOffice(collegeId);
      }

      // ─── [ PAYROLL MODULE ] ─────────────────────────────────────────────────

      match /salaryStructures/{structureId} {
        allow read: if isAccounts(collegeId) || isPrincipal(collegeId);
        allow write: if isAccounts(collegeId) || isPrincipal(collegeId);
      }

      match /salaryRecords/{recordId} {
        // Faculty can read their own payslip (API enforces facultyId match)
        allow read: if isStaff(collegeId);
        allow create: if isAccounts(collegeId) && hasCollegeId(collegeId);
        allow update: if isAccounts(collegeId) || isPrincipal(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /salaryAdvances/{advanceId} {
        allow read: if isAccounts(collegeId) || isHODorAbove(collegeId);
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isAccounts(collegeId) || isPrincipal(collegeId);
        allow delete: if isSuperAdmin();
      }

      match /payrollRuns/{runId} {
        allow read: if isAccounts(collegeId) || isPrincipal(collegeId);
        allow write: if isAccounts(collegeId);
      }

      // ─── [ TEACHING MODULE ] ────────────────────────────────────────────────

      match /subjects/{subjectId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId);
      }

      // Exam Cell's Internal/External marks configuration for a subject —
      // the single source of truth the Faculty Dashboard's Internal Exam
      // module reads from. Only Exam Cell (or Super Admin) may write it;
      // every other staff role may read it (Faculty needs to read their own
      // assigned subject's config; Principal/HOD get oversight visibility).
      match /examConfigurations/{configId} {
        allow read: if isStaff(collegeId) || isExamCell(collegeId);
        allow write: if isExamCell(collegeId);
      }

      match /teachingAssignments/{assignmentId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId);
      }

      // Cross-department requests to lend a faculty member for a subject
      // (see api/college/faculty-assignment-requests) - only HOD-and-above
      // create/fulfil these; every staff role may read for visibility.
      match /facultyAssignmentRequests/{requestId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId);
      }

      match /timetableSlots/{slotId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId);
      }

      // Faculty's own internal-exam marks batch (owner can create/edit while
      // DRAFT; locked once SUBMITTED). HOD is read-only here by design (see
      // GET /api/college/internal-exam-marks) — deliberately isPrincipal(),
      // not isHODorAbove(), so HOD never gets write/delete access even at
      // this coarse rules layer. Principal/VP/Super Admin may correct an
      // already-submitted batch (enforced status-aware server-side in
      // PATCH /internal-exam-marks/[id]).
      match /internalExamMarks/{markId} {
        allow read: if isStaff(collegeId);
        allow create: if isPanelMember(collegeId) && request.resource.data.facultyId == request.auth.uid;
        allow update: if isPrincipal(collegeId) ||
          (isPanelMember(collegeId) && resource.data.facultyId == request.auth.uid
            && resource.data.status == 'DRAFT');
        allow delete: if isPrincipal(collegeId);
      }

      // Faculty's own class attendance session for a section+subject+date
      // (owner can create/edit while DRAFT; locked once SUBMITTED — mirrors
      // internalExamMarks above).
      match /studentAttendance/{sessionId} {
        allow read: if isStaff(collegeId);
        allow create: if isPanelMember(collegeId) && request.resource.data.facultyId == request.auth.uid;
        allow update: if isHODorAbove(collegeId) ||
          (isPanelMember(collegeId) && resource.data.facultyId == request.auth.uid
            && resource.data.status == 'DRAFT');
        allow delete: if isHODorAbove(collegeId);
      }

      match /workloadSummaries/{summaryId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId);
      }

      // ─── [ APPRAISAL MODULE ] ───────────────────────────────────────────────

      match /appraisalCycles/{cycleId} {
        allow read: if isStaff(collegeId);
        allow write: if isPrincipal(collegeId);
      }

      match /appraisals/{appraisalId} {
        allow read: if isHODorAbove(collegeId) ||
          (isPanelMember(collegeId) && resource.data.facultyId == request.auth.uid);
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        // Self appraisal: faculty updates their own; HOD/Principal for their review
        allow update: if isHODorAbove(collegeId) ||
          (isPanelMember(collegeId) && resource.data.facultyId == request.auth.uid);
        allow delete: if isSuperAdmin();
      }

      // ─── [ TRAINING MODULE ] ────────────────────────────────────────────────

      match /trainingPrograms/{programId} {
        allow read: if isStaff(collegeId);
        allow write: if isHODorAbove(collegeId) || isCollegeOffice(collegeId);
      }

      match /trainingEnrollments/{enrollmentId} {
        allow read: if isStaff(collegeId);
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId) ||
          (isPanelMember(collegeId) && resource.data.facultyId == request.auth.uid);
        allow delete: if isHODorAbove(collegeId);
      }

      // ─── [ GRIEVANCE MODULE ] ───────────────────────────────────────────────

      match /grievances/{grievanceId} {
        // Anonymous grievances: requester can't be identified; HOD/Principal read all
        allow read: if isHODorAbove(collegeId) || isCollegeOffice(collegeId) ||
          (!resource.data.isAnonymous && isPanelMember(collegeId) &&
            resource.data.facultyId == request.auth.uid);
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isHODorAbove(collegeId) || isCollegeOffice(collegeId);
        allow delete: if isSuperAdmin();
      }

      // ─── [ FINANCE MODULE ] ─────────────────────────────────────────────────
      // All writes happen server-side via the Admin SDK in /api/college/finance-*
      // routes (guarded by requireCollegeMember("FINANCE", "SUPER_ADMIN")), so
      // client rules here only gate direct reads and block direct client writes.

      match /financeBudgets/{docId} {
        allow read: if isFinance(collegeId) || isPurchaseDept(collegeId);
        allow write: if false;
      }

      match /financeBudgetRequests/{docId} {
        allow read: if isFinance(collegeId);
        allow write: if false;
      }

      match /financeFundAllocations/{docId} {
        allow read: if isFinance(collegeId);
        allow write: if false;
      }

      match /financeExpenseRequests/{docId} {
        allow read: if isFinance(collegeId);
        allow write: if false;
      }

      match /financePayments/{docId} {
        allow read: if isFinance(collegeId);
        allow write: if false;
      }

      match /financePurchaseClearance/{docId} {
        allow read: if isFinance(collegeId) || isPurchaseDept(collegeId);
        allow write: if false;
      }

      match /financeReceipts/{docId} {
        allow read: if isFinance(collegeId);
        allow write: if false;
      }

      match /financeAuditLogs/{docId} {
        allow read: if isFinance(collegeId);
        allow write: if false;
      }

      // ─── [ SHARED ] ─────────────────────────────────────────────────────────

      match /notifications/{notificationId} {
        // Any authenticated user can read/mark their own notifications.
        // Does NOT require custom claims (role/collegeId) so it works before
        // the first post-claim login.
        allow read: if isAuthenticated() && resource.data.toUid == request.auth.uid;
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update: if isAuthenticated() && resource.data.toUid == request.auth.uid;
        allow delete: if isSuperAdmin();
      }

      match /auditLogs/{logId} {
        allow read: if isPrincipal(collegeId) || isSuperAdmin();
        allow create: if isStaff(collegeId) && hasCollegeId(collegeId);
        allow update, delete: if isSuperAdmin();
      }
    }
  }
}
